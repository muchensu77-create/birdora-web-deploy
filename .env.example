# Local development example only.
# Production uses deploy/env/birdora-web-auth.env.example.
PORT=4000
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:4174,http://127.0.0.1:4174
ALLOWED_ORIGINS=http://localhost:4174,http://127.0.0.1:4174
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=birdora_token
AUTH_RATE_LIMIT=30
COMMUNITY_WRITE_RATE_LIMIT=240
OBSERVATION_WRITE_RATE_LIMIT=240
RECOGNITION_RATE_LIMIT=120
CONTENT_REPORT_RATE_LIMIT=20
MODERATION_DECISION_RATE_LIMIT=120
DATABASE_FILE=app/data/birdora.sqlite
DATA_DIRECTORY=app/data
# Development may apply pending migrations automatically. Production must use
# the explicit db:preflight -> db:migrate deployment sequence.
DATABASE_AUTO_MIGRATE=true
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_DIR=app/data/backups
DATABASE_BACKUP_RETENTION=10
# Local upgrades automatically import users.json and revoked-tokens.json when
# present. Use "required" for a deliberate legacy cutover, or "disabled" for
# a clean database that must never inspect legacy JSON files.
LEGACY_JSON_IMPORT_MODE=optional
TRUST_PROXY=0
OUTBOX_WORKER_ENABLED=true
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_MAX_BACKLOG_EVENTS=10000
OUTBOX_MAX_BACKLOG_PAYLOAD_BYTES=16777216
OUTBOX_MAX_OLDEST_AGE_SECONDS=3600

# High-risk legacy paths stay disabled until their migrations, cleanup workers,
# and moderation gates have passed the roadmap acceptance tests.
COMMUNITY_PUBLISH_ENABLED=false
COMMUNITY_POST_EDIT_ENABLED=false
COMMUNITY_LEGACY_LIKE_ENABLED=false
ACCOUNT_DELETION_ENABLED=false
COMMUNITY_DEMO_ENABLED=false
ALLOW_EMPTY_DATABASE_INITIALIZATION=false
DIRECT_PORT_3003_FIREWALL_CONFIRMED=false
