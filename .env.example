# Local development example only.
# Production uses deploy/env/birdora-web-auth.env.example.
PORT=4000
CORS_ORIGIN=http://localhost:4174,http://127.0.0.1:4174
ALLOWED_ORIGINS=http://localhost:4174,http://127.0.0.1:4174
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=birdora_token
AUTH_RATE_LIMIT=30
DATABASE_FILE=app/data/birdora.sqlite
TRUST_PROXY=0
