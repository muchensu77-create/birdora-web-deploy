{
  "name": "birdora-web",
  "version": "1.7.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "birdoraDeployment": {
    "controllerProtocolVersion": 1
  },
  "description": "Birdora static site with Express JWT auth backend",
  "main": "server.js",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "test": "node scripts/test-core.js",
    "legacy:evaluate": "node scripts/evaluate-legacy-adoption-evidence.js",
    "test:legacy-adoption-evidence": "node scripts/test-legacy-adoption-evidence.js",
    "start": "node server.js",
    "start:api": "node server.js",
    "prestart:web": "node scripts/sync-public.js",
    "start:web": "node scripts/static-server.js",
    "sync:public": "node scripts/sync-public.js",
    "dev": "node --watch server.js",
    "db:preflight": "node scripts/database-preflight.js",
    "db:backup": "node scripts/backup-database.js",
    "db:migrate": "node scripts/migrate-database.js",
    "release:build": "bash scripts/build-release-artifact.sh",
    "release:manifest": "node scripts/create-release-manifest.js",
    "release:evidence": "node scripts/create-release-evidence.js",
    "release:verify": "node deploy/scripts/verify-release-manifest.js",
    "test:db": "node scripts/test-database-migrations.js",
    "test:db:safety": "node scripts/test-database-safety.js",
    "test:db:concurrency": "node scripts/test-database-concurrency.js",
    "test:deployment-contracts": "node scripts/test-deployment-contracts.js",
    "test:release-artifacts": "node scripts/test-release-artifacts.js",
    "test:activation-gate": "node scripts/test-activation-write-gate.js",
    "test:activation-journal": "node scripts/test-activation-journal.js",
    "test:release-pointer": "node scripts/test-release-pointer.js",
    "test:production-env": "node scripts/test-production-env.js",
    "test:database-lifecycle-lock": "node scripts/test-database-lifecycle-lock.js",
    "test:linux:deployment": "bash scripts/test-linux-deployment-semantics.sh",
    "test:linux:legacy-inventory": "bash scripts/test-legacy-inventory-linux-semantics.sh",
    "test:frontend-contracts": "node scripts/test-frontend-contracts.js",
    "test:phase0": "node scripts/test-phase0-backend.js",
    "test:integration": "node scripts/test-api-integration.js",
    "test:auth": "node scripts/test-auth.js",
    "test:browser": "node scripts/test-browser-e2e.js",
    "test:browser:50-pages": "node scripts/run-browser-50-page-flow.js",
    "test:browser:agents:report": "node scripts/summarize-browser-agent-results.js",
    "test:browser:user-flow": "node scripts/test-browser-user-flow-worker.js",
    "test:browser:recognition": "node scripts/test-browser-recognition-ramp.js",
    "test:recognition:server": "node scripts/test-recognition-server.js",
    "test:community": "node scripts/test-community.js",
    "test:observations": "node scripts/test-observations.js",
    "test:large-images": "node scripts/test-large-image-upload.js",
    "test:peak": "node scripts/test-peak.js",
    "test:prod:readonly": "node scripts/test-production-readonly.js",
    "test:atlas": "node scripts/validate-atlas-data.js",
    "atlas:template": "node scripts/create-atlas-profile-template.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "heic-to": "^1.5.2",
    "jpeg-js": "^0.4.4",
    "jsonwebtoken": "^9.0.2",
    "onnxruntime-node": "^1.27.0"
  }
}
