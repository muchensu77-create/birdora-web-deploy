NODE_ENV=production
NODE_INTERPRETER=/opt/node-v24/bin/node
PORT=3003
HOST=127.0.0.1
CORS_ORIGIN=https://birdora.birdai-glasses.com
ALLOWED_ORIGINS=https://birdora.birdai-glasses.com
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=birdora_token
COOKIE_SECURE=true
AUTH_RATE_LIMIT=30
COMMUNITY_WRITE_RATE_LIMIT=240
OBSERVATION_WRITE_RATE_LIMIT=240
RECOGNITION_RATE_LIMIT=120
RECOGNITION_MAX_CONCURRENCY=2
RECOGNITION_MAX_QUEUE=8
RECOGNITION_QUEUE_TIMEOUT_MS=10000
CONTENT_REPORT_RATE_LIMIT=20
MODERATION_DECISION_RATE_LIMIT=120
DATABASE_FILE=/var/lib/birdora/birdora.sqlite
DATA_DIRECTORY=/var/lib/birdora
# Drain and stop every old instance before running db:migrate explicitly.
# Ordinary production server startup must never execute pending DDL.
DATABASE_AUTO_MIGRATE=false
DATABASE_BACKUP_ENABLED=true
DATABASE_BACKUP_DIR=/var/lib/birdora-protected/backups
DATABASE_BACKUP_RETENTION=20
COMMUNITY_UPLOAD_DIR=/var/lib/birdora/uploads/community
OBSERVATION_UPLOAD_DIR=/var/lib/birdora/uploads/observations
# Production starts must not implicitly consume mutable legacy JSON files.
# Temporarily set "required" only for an explicitly supervised cutover.
LEGACY_JSON_IMPORT_MODE=disabled
TRUST_PROXY=1
# Keep disabled until staging has verified claim/retry/dead-letter behavior and
# the activation journal pause gate on the target Ubuntu host.
OUTBOX_WORKER_ENABLED=false
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_MAX_BACKLOG_EVENTS=10000
OUTBOX_MAX_BACKLOG_PAYLOAD_BYTES=16777216
OUTBOX_MAX_OLDEST_AGE_SECONDS=3600
COMMUNITY_PUBLISH_ENABLED=false
COMMUNITY_POST_EDIT_ENABLED=false
COMMUNITY_LEGACY_LIKE_ENABLED=false
ACCOUNT_DELETION_ENABLED=false
COMMUNITY_DEMO_ENABLED=false
# Set true only for the first install when no prior PM2 release/data marker exists.
ALLOW_EMPTY_DATABASE_INITIALIZATION=false
# Set true only after the host/cloud firewall is verified to block direct TCP 3003
# during the one-time upgrade from a legacy wildcard listener.
DIRECT_PORT_3003_FIREWALL_CONFIRMED=false
# Required for the first controlled upgrade when no activationVerified release marker exists.
# Set this to the exact commit currently deployed; never guess HEAD^.
# PREVIOUS_RELEASE_REF=<exact-40-character-current-production-commit>
